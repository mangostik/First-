OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
MCP_ACCESS_TOKEN=
MCP_PATH_TOKEN=
OPENAI_APPS_CHALLENGE_TOKEN=
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Provider review cost modes: cheap (default), standard, or manual-only deep.
REVIEW_MODE=cheap
REVIEW_MAX_CHUNKS=4
REVIEW_MAX_ROUNDS=1
REVIEW_MAX_PROVIDER_CALLS=8
REVIEW_MAX_OUTPUT_TOKENS=1200
REVIEW_TIME_BUDGET_MS=240000
REVIEW_COST_BUDGET_USD=0.50
REVIEW_ESTIMATED_COST_PER_1K_TOKENS_USD=0.01
# Legacy aliases remain supported for deep/manual compatibility.
MAX_ROUNDS=3
MAX_OUTPUT_TOKENS=1800
REQUEST_TIMEOUT_MS=120000
CLAUDE_REQUEST_TIMEOUT_MS=120000
OPENAI_REQUEST_TIMEOUT_MS=120000
PROVIDER_MAX_RETRIES=1
STRUCTURED_MAX_RETRIES=1
REVIEW_LOOP_TIMEOUT_MS=600000
REVIEW_LOOP_GUARD_MS=1000
# Upper bound for synchronous MCP run_agent_review calls; keep below the MCP gateway timeout.
MCP_REVIEW_DEADLINE_MS=240000

# Parallel orchestration MVP
JOB_STORAGE_DIR=.orchestration-jobs
# Safe production defaults. Keep mock modes until production worktree support exists.
ORCHESTRATION_MAX_PARALLEL=2
ORCHESTRATION_MAX_SUBTASKS=10
ORCHESTRATION_TIMEOUT_MS=30000
ORCHESTRATION_MAX_RETRIES=1
ORCHESTRATION_JOB_TIMEOUT_MS=300000
ORCHESTRATION_LOG_EVENTS=0
ORCHESTRATION_TRACKER_TOKEN=
ORCHESTRATION_AGENT_MODE=mock
ORCHESTRATION_REVIEWER_MODE=mock
ORCHESTRATION_TEST_MODE=mock
ORCHESTRATION_TEST_TIMEOUT_MS=120000
ORCHESTRATION_TEST_COMMAND=npm test
ORCHESTRATION_BASE_REF=stage4-mcp
ORCHESTRATION_REPO_ROOT=..
ORCHESTRATION_ALLOWED_ROOT=..
ORCHESTRATION_WORKSPACE_ROOT=../.orchestration-workspaces
